{
  "name": "xx-cli",
  "module": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun src/index.ts",
    "build": "bun build src/index.ts --target=bun --outfile dist/xx",
    "compile": "bun scripts/compile.ts",
    "clean": "rm -rf dist",
    "test": "bun test",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js,json,md}": "prettier --write"
  },
  "private": true,
  "devDependencies": {
    "@types/bun": "latest",
    "@types/semver": "^7.7.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "cli-table3": "^0.6.5",
    "commander": "^14.0.3",
    "picocolors": "^1.1.1",
    "prettier": "^3.8.3",
    "semver": "^7.8.0",
    "zod": "^4.4.3"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
